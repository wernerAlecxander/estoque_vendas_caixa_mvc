/**
 * -- revisar as tabelas
 * -- conferir todos os campos obrigatórios para emissão fiscal e validação SEFAZ
 * -- conferir todos os relacionamentos e chaves estrangeiras
 * -- organizar documento_fiscal para emitir nota fiscal.
 * -- semear as tabelas de status, categoria, marcas, modelos, etc.
 * -- preparar o split payment para realizar pagamentos automáticos para o Governo
 */

generator client {
  provider = "prisma-client-js" // O novo padrão otimizado do Prisma 7
  output   = "./generated/client" // para evitar sumir no node_modules
}

datasource db {
  provider = "postgresql"
}

model parceiros {
  // campos obrigatórios para validação fiscal e emissão de NF-e/NFC-e
  id                 String  @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  nome_completo_PF   String? @unique @db.VarChar(100)
  razao_social_PJ    String? @unique @db.VarChar(100)
  CPF                String? @unique @db.VarChar(14) // Suporta CPF ou CNPJ formatados
  CNPJ               String? @unique @db.VarChar(18) // Suporta CPF ou CNPJ formatados
  Inscricao_Estadual String? @db.VarChar(14) // Inscrição Estadual (Obrigatório para PJ contribuinte)

  // Endereço estruturado para SEFAZ
  logradouro      String  @db.VarChar(150) // endereço parceiro
  numero_endereco String? @db.VarChar(10) // Número do endereço
  bairro          String  @db.VarChar(100)
  CEP             String? @default("69.300-000") @db.VarChar(9)
  cidade          String? @default("Boa Vista") @db.VarChar(100)
  UF              String? @default("RR") @db.VarChar(2) // Obrigatório para validação fiscal
  codigo_IBGE     String  @default("1400100") @db.VarChar(7) // Código IBGE (Boa Vista = 1400100). Código para cada cidade do Brasil. Obrigatório para emissão de NF-e/NFC-e.
  pais_country    String? @default("Brasil") @db.VarChar(50)

  telefone     String   @db.VarChar(20)
  email        String?  @unique @db.VarChar(100)
  // auditoria
  cadastradoEm DateTime @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime @default(now()) @db.Timestamp(6)

  // Relacionamentos Mapeados
  pedidos_venda              pedidos_vendas[] // parceiro_comprador_id
  sucata_compra              sucata_compras[] // parceiro_vendedor_id
  veiculos_parceiro          veiculos_parceiro_manutencao[] // parceiro_id
  ordens_servico             ordem_servico[] // parceiro_id
  sucatas_compradas_inteiras sucata_estoque[]               @relation("CompradorSucataInteira") // parceiro_comprador_id.

  @@map("parceiros")
}
//ok

model compatibilidade_pecas {
  id               String       @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  peca_estoque_id  String       @db.Uuid
  modelo_origem_id Int
  ano_inicio       Int?
  ano_fim          Int?
  // auditoria
  cadastradoEm     DateTime     @default(now()) @db.Timestamp(6)
  atualizadoEm     DateTime     @default(now()) @db.Timestamp(6)
  // relacionamentos estruturais
  modelos          modelos      @relation(fields: [modelo_origem_id], references: [id], onUpdate: Restrict, map: "fk_compativel_peca_modelo_marca") //ok
  peca_estoque     peca_estoque @relation(fields: [peca_estoque_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_peca_compativel") //ok

  // Garante que não existam registros duplicados para a mesma peça e modelo de veículo
  @@unique([peca_estoque_id, ano_inicio, ano_fim], map: "uc_peca_modelo")
}
//ok

model estoque_objetos_duraveis {
  id                           String                          @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  nome_objeto_duravel          String                          @db.VarChar(100)
  categoria_id                 Int
  data_compra                  DateTime                        @db.Timestamp(6)
  status_objeto_duravel        String                          @db.VarChar(25) //@default("ATIVO")
  responsavel_compra_id        String                          @db.Uuid
  data_descarte                DateTime?                       @db.Timestamp(6)
  responsavel_descarte_id      String?                         @db.Uuid
  valor_compra                 Decimal                         @db.Decimal(10, 2)
  tempo_garantia               Int?                            @default(12) // em meses
  data_limite_garantia         DateTime                        @default(dbgenerated("(now() + (tempo_garantia || ' months')::interval)")) @db.Timestamp(6)
  // CAMPOS ADICIONADOS PARA DEPRECIAÇÃO GERENCIAL INTERNA
  data_ativacao_gerencial      DateTime?                       @db.Timestamp(6) // Quando começou a ser usado
  taxa_depreciacao_interna     Decimal?                        @db.Decimal(5, 2) // Ex: 50.00 (se ele dura 2 anos e deprecia 50% ao ano)
  data_fim_depreciacao_interna DateTime?                       @default(dbgenerated("(now() + (COALESCE((100 / NULLIF(taxa_depreciacao_interna, 0)) * 12, 0) || ' months')::interval)")) @db.Timestamp(6) // Ex: 24 meses
  // auditoria
  cadastradoEm                 DateTime                        @default(now()) @db.Timestamp(6)
  atualizadoEm                 DateTime                        @default(now()) @db.Timestamp(6)
  // Relacionamento reverso para o Fluxo de Caixa registrar a saída
  lancamentos_caixa            fluxo_caixa[] // objeto_duravel_id
  // Relacionamentos Estruturais
  responsavel_compra           usuarios                        @relation("responsavel_compra", fields: [responsavel_compra_id], references: [id], onUpdate: Restrict, map: "fk_responsavel_compra")
  responsavel_descarte         usuarios?                       @relation("responsavel_descarte", fields: [responsavel_descarte_id], references: [id], onUpdate: Restrict, map: "fk_responsavel_descarte")
  categoria_objeto_duravel_id  categoria_duraveis_imobilizados @relation(fields: [categoria_id], references: [id], onUpdate: Restrict, map: "fk_categoria_duraveis_imobilizados")
  status_objeto                status_ativo                    @relation(fields: [status_objeto_duravel], references: [status_objeto], onUpdate: Restrict, map: "fk_status_ativo_duraveis_imobilizados")
}
//ok

model estoque_objetos_imobilizados {
  id                              String                          @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  codigo_patrimonial              String?                         @unique @db.VarChar(50) // Ex: IMOB-2026-001
  nome_objeto_imoblizado          String                          @db.VarChar(100)
  categoria_id                    Int
  status_objeto_imobilizado       String                          @db.VarChar(25) //@default("ATIVO")
  data_compra                     DateTime                        @db.Timestamp(6)
  data_ativacao                   DateTime?                       @db.Timestamp(6) // Quando começa a depreciar efetivamente
  responsavel_cadastro_id         String                          @db.Uuid
  valor_aquisicao                 Decimal                         @db.Decimal(10, 2)
  valor_residual                  Decimal                         @default(0.00) @db.Decimal(10, 2) // Valor de sucata/desmanche final
  taxa_depreciacao_anual          Decimal                         @db.Decimal(5, 2) // Ex: 20.00 para 20%
  vida_util_meses                 Int // Ex: 60 meses para computadores
  // auditoria
  cadastradoEm                    DateTime                        @default(now()) @db.Timestamp(6)
  atualizadoEm                    DateTime                        @default(now()) @db.Timestamp(6)
  // Relacionamento reverso
  lancamentos_caixa               fluxo_caixa[] // objeto_imobilizado_id
  // Relacionamentos Estruturais
  status_objeto                   status_ativo                    @relation(fields: [status_objeto_imobilizado], references: [status_objeto], onUpdate: Restrict, map: "fk_status_ativo_duraveis_imobilizados")
  categoria_objeto_imobilizado_id categoria_duraveis_imobilizados @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  responsavel_cadastro            usuarios                        @relation(fields: [responsavel_cadastro_id], references: [id], onUpdate: Restrict)
}
//ok

// SEED
model categoria_duraveis_imobilizados {
  id                           Int                            @id @default(autoincrement())
  // Campos obrigatórios para validação fiscal e emissão de NF-e/NFC-e
  nome_categoria               String                         @unique @db.VarChar(100)
  // @@index([nome_categoria], map: "idx_nome_categoria")
  descricao                    String?                        @db.VarChar(200)
  // Campos de auditoria
  cadastradoEm                 DateTime                       @default(now()) @db.Timestamp(6)
  atualizadoEm                 DateTime                       @default(now()) @db.Timestamp(6)
  // Relacionamentos reversos
  estoque_objetos_duraveis     estoque_objetos_duraveis[] // categoria_id
  estoque_objetos_imobilizados estoque_objetos_imobilizados[] // categoria_id
}
//ok

model status_ativo {
  id                           Int                            @id @default(autoincrement())
  status_objeto                String                         @unique @db.VarChar(50)
  // auditoria
  cadastradoEm                 DateTime                       @default(now()) @db.Timestamp(6)
  atualizadoEm                 DateTime                       @default(now()) @db.Timestamp(6)
  // Relacionamentos reversos
  estoque_objetos_imobilizados estoque_objetos_imobilizados[] // status_objeto_imobilizado
  estoque_objetos_duraveis     estoque_objetos_duraveis[] // status_objeto_duravel

  @@map("status_ativo")
}
//ok

model estoque_objetos_genericos {
  id                    String        @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  nome_objeto_generico  String        @db.VarChar(100)
  preco_unitario        Decimal       @default(0.00) @db.Decimal(10, 2)
  quantidade_comprada   Int           @default(1)
  valor_desconto        Decimal       @default(0.00) @db.Decimal(10, 2)
  // Campo Gerado Nativo no PostgreSQL (Prisma 7.x reconhece via dbgenerated)
  preco_total_compra    Decimal       @default(dbgenerated("((quantidade_comprada * preco_unitario) - valor_desconto)")) @db.Decimal(10, 2)
  data_compra           DateTime      @db.Timestamp(6)
  // Controle de Uso (Almoxarifado Retirada)
  responsavel_compra_id String        @db.Uuid
  data_inicio_uso       DateTime?     @db.Timestamp(6)
  responsavel_uso_id    String?       @db.Uuid
  // auditoria
  cadastradoEm          DateTime      @default(now()) @db.Timestamp(6)
  atualizadoEm          DateTime      @default(now()) @db.Timestamp(6)
  // Relacionamentos Estruturais
  responsavel_compra    usuarios      @relation("compra_genericos", fields: [responsavel_compra_id], references: [id], onUpdate: Restrict, map: "fk_responsavel_compra")
  responsavel_uso       usuarios?     @relation("uso_genericos", fields: [responsavel_uso_id], references: [id], onUpdate: Restrict, map: "fk_responsavel_uso")
  // Relacionamento reverso para o Fluxo de Caixa registrar a saída
  lancamentos_caixa     fluxo_caixa[] // objeto_generico_id
  // Opcional: Se quiser garantir via banco que compras desse modelo não estourem R$ 1.200 por unidade
  // @@check("preco_unitario < 1200.00")
}
//ok

model marcas_veiculo {
  id           Int       @id @default(autoincrement())
  nome         String    @unique @db.VarChar(50)
  // auditoria
  cadastradoEm DateTime  @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime  @default(now()) @db.Timestamp(6)
  modelos      modelos[] // marcas_veiculo_id
}
//ok

model modelos {
  id                           Int                            @id @default(autoincrement())
  marcas_veiculo_id            Int
  nome_modelo                  String                         @db.VarChar(100)
  // auditoria
  cadastradoEm                 DateTime                       @default(now()) @db.Timestamp(6)
  atualizadoEm                 DateTime                       @default(now()) @db.Timestamp(6)
  // Relacionamentos reversos
  compatibilidade_pecas        compatibilidade_pecas[] // modelo_origem_id
  peca_estoque                 peca_estoque[] // modelo_origem_id
  sucata_estoque               sucata_estoque[] // modelo_id
  veiculos_parceiro_manutencao veiculos_parceiro_manutencao[] // modelo_id
  // Relacionamento estrutural
  marcas_veiculo               marcas_veiculo                 @relation(fields: [marcas_veiculo_id], references: [id], onUpdate: NoAction, map: "fk_marca")

  @@unique([marcas_veiculo_id, nome_modelo], map: "uk_marca_modelo")
}
//ok

model categoria_peca {
  id           Int            @id @default(autoincrement())
  nome         String         @unique @db.VarChar(100)
  descricao    String?        @db.VarChar(200)
  // auditoria
  cadastradoEm DateTime       @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime       @default(now()) @db.Timestamp(6)
  peca_estoque peca_estoque[] // categoria_peca_id
  tipo_servico tipo_servico[] // categoria_servico
}
//ok

model localizacao_peca {
  id           Int            @id @default(autoincrement())
  setor        String         @db.VarChar(50) // Ex: "Setor A"
  corredor     String         @db.VarChar(50) // Ex: "Corredor 02"
  armario      String         @db.VarChar(50) // Ex: "Armário 15"
  prateleira   String?        @db.VarChar(50) // Ex: "Prateleira C" (Opcional)
  // auditoria
  cadastradoEm DateTime       @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime       @default(now()) @db.Timestamp(6)
  // Relacionamento reverso: uma localização pode conter várias peças
  pecas        peca_estoque[]

  // Garante que não existam re       gistros duplicados para o mesmo endereço físico
  @@unique([setor, corredor, armario, prateleira], map: "uc_status_item_endereco_estoque")
}
//ok

model peca_estoque {
  id                    String  @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  veiculo_origem_id     String  @db.Uuid
  nome_peca             String  @db.VarChar(100)
  modelo_origem_id      Int
  categoria_peca_id     Int
  // @@index([categoria_peca_id], map: "idx_categoria_peca_id")
  preco                 Decimal @default(0.00) @db.Decimal(10, 2)
  status_peca           Int
  responsavel_compra_id String  @db.Uuid

  localizacao_peca_id   Int
  data_cadastro         DateTime?               @default(now()) @db.Timestamp(6)
  // auditoria
  cadastradoEm          DateTime                @default(now()) @db.Timestamp(6)
  atualizadoEm          DateTime                @default(now()) @db.Timestamp(6)
  // --- NOVAS RELAÇÕES FISCAIS E DE SAÍDA (O.S. / BALCÃO) ---
  dados_fiscais         dados_fiscais_peca? // Informações fiscais vinculadas
  itens_pedido_vendas   itens_pedido_vendas[] // 
  os_pecas_itens        os_pecas_itens[] // Permite vincular o uso desta peça no novo módulo de O.S.
  // Relacionamentos Estruturais
  compatibilidade_pecas compatibilidade_pecas[] // peca_estoque_id
  modelos               modelos                 @relation(fields: [modelo_origem_id], references: [id], onUpdate: Restrict, map: "fk_modelo_origem_id_pecas")
  usuarios              usuarios                @relation(fields: [responsavel_compra_id], references: [id], onUpdate: Restrict, map: "fk_responsavel_compra_id")
  sucata_estoque        sucata_estoque          @relation(fields: [veiculo_origem_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_veiculo_origem_id_veiculo_sucata")
  peca_imagens          peca_imagens[]
  categoria_peca        categoria_peca          @relation(fields: [categoria_peca_id], references: [id], onUpdate: Restrict, map: "fk_categoria_peca_id")
  localizacao_peca      localizacao_peca        @relation(fields: [localizacao_peca_id], references: [id], onUpdate: Restrict, map: "fk_localizacao_peca_id") // Relacionamento reverso para o histórico de localização da peça
  status_peca_id        status_item             @relation(fields: [status_peca], references: [id], onUpdate: Restrict, map: "fk_status_peca_id")

  @@unique([veiculo_origem_id, modelo_origem_id, nome_peca], map: "uc_peca_modelo_origem")
}

// tabela obrigatoria para faturamento automático SEFAZ/RR e regras de 2026
model dados_fiscais_peca {
  id              String  @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  peca_id         String  @unique @db.Uuid
  NMC_Mercosul    String  @db.VarChar(8) // Nomenclatura Comum do Mercosul. Obrigatório nacional (Ex: Peças = 8708.xx.xx)
  CEST_tributario String? @db.VarChar(7) // Código Especificador da Substituição Tributária (se aplicável em RR)
  CFOP_id         String  @default("01900000-0000-7000-8000-000000005102") @db.Uuid // Código Fiscal de Operações e Prestações. Obrigatório para emissão fiscal. Vinculado à tabela de CFOPs.
  CST_ICMS        String  @default("000") @db.VarChar(3) // Regime Normal ou CSOSN para Simples Nacional

  // Adaptação Obrigatória Reforma Tributária 2026 (Nota Técnica Padrão RTC)
  CST_IBS_CBS String? @db.VarChar(3) // Código de Situação Tributária unificado da Reforma
  CClassTrib  String? @db.VarChar(5) // Código de classificação tributária do produto

  peca_estoque peca_estoque @relation(fields: [peca_id], references: [id], onDelete: Cascade)
  CFOP         CFOPS        @relation(fields: [CFOP_id], references: [id], onUpdate: Restrict)
  // auditoria
  cadastradoEm DateTime     @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime     @default(now()) @db.Timestamp(6)

  @@map("dados_fiscais_peca")
}

model peca_imagens {
  id            String       @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  peca_id       String       @db.Uuid
  url_imagem    String
  principal     Boolean?     @default(false)
  data_cadastro DateTime?    @default(now()) @db.Timestamp(6)
  // auditoria
  cadastradoEm  DateTime     @default(now()) @db.Timestamp(6)
  atualizadoEm  DateTime     @default(now()) @db.Timestamp(6)
  peca_estoque  peca_estoque @relation(fields: [peca_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_peca_id")
}

model itens_pedido_vendas {
  id                String         @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  pedido_venda_id   String         @db.Uuid
  peca_estoque_id   String         @db.Uuid
  quantidade_peca   Int            @default(1)
  preco_unitario    Decimal        @db.Decimal(10, 2)
  preco_total       Decimal        @db.Decimal(10, 2)
  valor_desconto    Decimal        @default(0.00) @db.Decimal(10, 2)
  data_fim_garantia DateTime       @db.Date
  status_item       Int
  data_devolucao    DateTime?      @db.Timestamp(6)
  motivo_devolucao  String?        @db.VarChar(500)
  // auditoria
  cadastradoEm      DateTime       @default(now()) @db.Timestamp(6)
  atualizadoEm      DateTime       @default(now()) @db.Timestamp(6)
  peca_estoque      peca_estoque   @relation(fields: [peca_estoque_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_peca_venda")
  pedidos_vendas    pedidos_vendas @relation(fields: [pedido_venda_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pedido_venda")
  status_item_id    status_item    @relation("status_itens_pedido_vendas", fields: [status_item], references: [id], onUpdate: Restrict, onDelete: Cascade, map: "fk_status_item_pedido")
}

model pedidos_vendas {
  // campos obrigatórios para emissão fiscal e fluxo de caixa
  id                    String             @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  data_venda            DateTime           @default(now()) @db.Timestamp(6)
  valor_total           Decimal            @default(0.00) @db.Decimal(10, 2)
  metodo_pagamento      metodo_pagamento
  status_pedido         Int
  observacoes_recibo    String?            @db.VarChar(500)
  //campos escalares
  parceiro_comprador_id String             @db.Uuid
  responsavel_venda_id  String             @db.Uuid
  // auditoria
  cadastradoEm          DateTime           @default(now()) @db.Timestamp(6)
  atualizadoEm          DateTime           @default(now()) @db.Timestamp(6)
  //Relacionamento de campos escalares
  parceiro_comprador    parceiros          @relation(fields: [parceiro_comprador_id], references: [id], onUpdate: Restrict, map: "fk_parceiro_comprador_id")
  responsavel_venda     usuarios           @relation(fields: [responsavel_venda_id], references: [id], onUpdate: Restrict, map: "fk_responsavel_venda")
  status_pedido_id      status_pedido      @relation(fields: [status_pedido], references: [id], onUpdate: Restrict, onDelete: Cascade, map: "fk_status_pedido_id")
  // --- NOVOS RELACIONAMENTOS PARA EMISSÃO FISCAL E FLUXO DE CAIXA ---
  documento_fiscal      documento_fiscal? // Vinculo com NF-e / NFC-e gerada para esta venda
  lancamentos_caixa     fluxo_caixa[] // Vinculo com o registro de entrada financeira do caixa
  osServicosItens       os_servicos_itens? @relation(fields: [os_servicos_itensId], references: [id])
  os_servicos_itensId   String?            @db.Uuid

  // ADICIONADO APENAS PARA A DRE: Para saber em qual conta de receita esse pedido entra
  plano_contas_id     String?               @db.Uuid
  plano_contas        plano_contas?         @relation(fields: [plano_contas_id], references: [id])
  // RELAÇÃO REVERSA OBRIGATÓRIA
  movimentacoes       Movimentacao[]
  itens_pedido_vendas itens_pedido_vendas[]

  @@map("pedidos_vendas")
}

// ==========================================
// ARQUITETURA DE ORDENS DE SERVIÇO (O.S.)
// ==========================================

model ordem_servico {
  id             String @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  parceiro_id    String @db.Uuid
  veiculo_id     String @db.Uuid
  responsavel_id String @db.Uuid // Funcionário que abriu / gerencia a OS

  data_abertura         DateTime  @default(now()) @db.Timestamp(6)
  data_previsao_entrega DateTime? @db.Timestamp(6)
  data_fechamento       DateTime? @db.Timestamp(6)

  status_os           Int // 0 = Aberta, 1 = Em andamento, 2 = Concluída, 3 = Cancelada
  descricao_problema  String  @db.Text // Reclamação inicial do parceiro
  diagnostico_tecnico String? @db.Text // Avaliação da oficina

  // Consolidação financeira da O.S.
  valor_servicos       Decimal                      @default(0.00) @db.Decimal(10, 2)
  valor_pecas          Decimal                      @default(0.00) @db.Decimal(10, 2)
  valor_desconto       Decimal                      @default(0.00) @db.Decimal(10, 2)
  valor_total          Decimal                      @default(0.00) @db.Decimal(10, 2)
  // auditoria
  cadastradoEm         DateTime                     @default(now()) @db.Timestamp(6)
  atualizadoEm         DateTime                     @default(now()) @db.Timestamp(6)
  // Relacionamentos Estruturais
  parceiros            parceiros                    @relation(fields: [parceiro_id], references: [id], onUpdate: Restrict)
  veiculo              veiculos_parceiro_manutencao @relation(fields: [veiculo_id], references: [id], onUpdate: Restrict)
  usuario_responsavel  usuarios                     @relation(fields: [responsavel_id], references: [id], onUpdate: Restrict)
  status_manutencao_id status_manutencao            @relation(fields: [status_os], references: [id], onUpdate: Restrict)

  // Itens da O.S. (Múltiplas Peças e Serviços)
  servicos_itens os_servicos_itens[]
  pecas_itens    os_pecas_itens[]

  // Integração Módulos Fiscais e Financeiro
  documento_fiscal  documento_fiscal? // Nota de Serviço (Prefeitura) ou Conjugada (SEFAZ)
  lancamentos_caixa fluxo_caixa[] // Registro de entrada financeira no Caixa

  @@map("ordem_servico")
}

// Detalhamento dos Serviços Executados na O.S.
model os_servicos_itens {
  id               String @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  ordem_servico_id String @db.Uuid
  tipo_servico_id  String @db.Uuid
  mecanico_id      String @db.Uuid // Vincula a comissão ao mecânico correto

