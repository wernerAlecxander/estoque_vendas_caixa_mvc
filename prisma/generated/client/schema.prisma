/**
 * SEED
 * tipo_objeto_receita {
 * PECA          @map("PEÇA")
 * SUCATA
 * SERVICO       @map("SERVIÇO")
 * RECEITA_EXTRA @map("RECEITA EXTRA")
 * }
 */

model tipo_objeto_receita {
  id                        Int                    @id @default(autoincrement())
  nome_tipo_receita         String                 @unique @db.VarChar(50)
  // auditoria
  cadastradoEm              DateTime               @default(now()) @db.Timestamp(6)
  atualizadoEm              DateTime               @default(now()) @db.Timestamp(6)
  tipo_receita_configuracao configuracao_imposto[]
}

model configuracao_imposto {
  id                     String              @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  tipo_objeto_receita_id Int                 @unique
  // --- IMPOSTOS TRADICIONAIS (PERÍODO DE TRANSIÇÃO / ATUAIS) ---
  aliquota_iss           Decimal             @default(0) @db.Decimal(5, 2) // Prestação de Serviços (Boa Vista)
  aliquota_icms          Decimal             @default(0) @db.Decimal(5, 2) // Circulação de Peças/Sucata (SEFAZ/RR)
  aliquota_pis           Decimal             @default(0) @db.Decimal(5, 2)
  aliquota_cofins        Decimal             @default(0) @db.Decimal(5, 2)
  // --- ADAPTAÇÃO REFORMA TRIBUTÁRIA 2026 (OBRIGATÓRIO PARA TESTES E TRANSIÇÃO) ---
  aliquota_ibs           Decimal             @default(0) @db.Decimal(5, 2) // Imposto sobre Bens e Serviços (Estadual/Municipal)
  aliquota_cbs           Decimal             @default(0) @db.Decimal(5, 2) // Contribuição sobre Bens e Serviços (Federal)
  percentual_reducao_ibs Decimal             @default(0) @db.Decimal(5, 2) // Caso haja regimes diferenciados
  percentual_reducao_cbs Decimal             @default(0) @db.Decimal(5, 2)
  data_atualizacao       DateTime            @updatedAt @map("data de atualização")
  // auditoria
  cadastradoEm           DateTime            @default(now()) @db.Timestamp(6)
  atualizadoEm           DateTime            @default(now()) @db.Timestamp(6)
  // Relacionamento Estrutural
  tipo_receita           tipo_objeto_receita @relation(fields: [tipo_objeto_receita_id], references: [id], onUpdate: Restrict, map: "fk_tipo_objeto_receita_id")

  @@map("configuracao_imposto")
}

// ==========================================
// MÓDULO FINANCEIRO (CAIXA / DESPESAS)
// ==========================================
enum metodo_pagamento {
  Pix
  Debito
  Credito
  Dinheiro
  cheque
}

enum tipo_despesa {
  FIXA
  VARIAVEL

  @@map("tipo_despesa")
}

// PARA ESTRUTURAÇÃO DO DRE ---
enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum StatusMovimentacao {
  PENDENTE // para compras e vendas parceladas, quando o pagamento ainda não foi realizado, ou quando a nota fiscal ainda não foi emitida, ou quando o pagamento ainda não foi confirmado, ou quando ainda faltam parcelas a serem pagas.
  PAGO
}

// PARA ESTRUTURAÇÃO DO DRE ---
model tipo_conta_plano {
  id           Int            @id @default(autoincrement())
  nome         String         @unique @db.VarChar(50)
  // auditoria
  cadastradoEm DateTime       @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime       @default(now()) @db.Timestamp(6)
  // relacionamentos reversos
  plano_contas plano_contas[]
}

// --- CENTRALIZADOR DO DRE (PLANO DE CONTAS) ---
model plano_contas {
  id              String @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  codigo_contabil String @unique // Ex: "1.01", "1.02", "2.01" para ordenar o relatório
  nome_conta      String @db.VarChar(100) // Ex: "Faturamento de Produtos", "Matéria Prima"
  tipo_dre        Int // Classificação rígida exigida pela estrutura da DRE

  // Relacionamentos reversos
  despesas          despesas[]
  lancamentos_caixa fluxo_caixa[] // Toda a inteligência da DRE e Caixa passará por aqui
  pedidos_vendas    pedidos_vendas[]
  movimentacoes     Movimentacao[]
  // auditoria
  cadastradoEm      DateTime         @default(now()) @db.Timestamp(6)
  atualizadoEm      DateTime         @default(now()) @db.Timestamp(6)
  // RELAÇÕES ESTRUTURAIS
  tipo_conta_dre    tipo_conta_plano @relation(fields: [tipo_dre], references: [id], onUpdate: Restrict, map: "fk_tipo_dre_id")

  @@map("plano_contas")
}

// --- O ELO FINANCEIRO (MOVIMENTAÇÃO DE CAIXA / PARCELAS) ---
model Movimentacao {
  id              String             @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  valor           Decimal            @db.Decimal(10, 2)
  tipo            TipoMovimentacao // ENTRADA ou SAIDA
  status          StatusMovimentacao // PENDENTE ou PAGO
  data_vencimento DateTime
  data_pagamento  DateTime?
  // auditoria
  cadastradoEm    DateTime           @default(now()) @db.Timestamp(6)
  atualizadoEm    DateTime           @default(now()) @db.Timestamp(6)

  // Chave estrangeira para o Plano de Contas (Inteligência do DRE)
  plano_contas_id String       @db.Uuid
  plano_contas    plano_contas @relation(fields: [plano_contas_id], references: [id])

  // Chaves estrangeiras opcionais para rastreabilidade (Origem do dinheiro)
  pedido_venda_id String?         @db.Uuid
  pedido_venda    pedidos_vendas? @relation(fields: [pedido_venda_id], references: [id])

  despesa_id String?   @db.Uuid
  despesa    despesas? @relation(fields: [despesa_id], references: [id])

  @@map("movimentacoes")
}

model tipo_despesa_fixa {
  id           Int        @id @default(autoincrement())
  nome         String     @unique @db.VarChar(100)
  // auditoria
  cadastradoEm DateTime   @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime   @default(now()) @db.Timestamp(6)
  despesas     despesas[]
}

model tipo_despesa_variavel {
  id           Int        @id @default(autoincrement())
  nome         String     @unique @db.VarChar(100)
  // auditoria
  cadastradoEm DateTime   @default(now()) @db.Timestamp(6)
  atualizadoEm DateTime   @default(now()) @db.Timestamp(6)
  despesas     despesas[]
}

model despesas {
  id                       String                 @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  descricao_despesa        String?                @db.VarChar(255)
  tipo_despesa             tipo_despesa? //despesa fixa OU despesa variavel para futuramente carcular custo fixo, custo variavel e custo marginal.
  tipo_despesa_fixa_id     Int?
  tipo_despesa_variavel_id Int?
  valor_despesa            Decimal                @db.Decimal(10, 2)
  data_despesa             DateTime               @db.Timestamp(6)
  // auditoria
  cadastradoEm             DateTime               @default(now()) @db.Timestamp(6)
  atualizadoEm             DateTime               @default(now()) @db.Timestamp(6)
  // Relacionamentos estruturais
  despesa_fixa_id          tipo_despesa_fixa?     @relation(fields: [tipo_despesa_fixa_id], references: [id], onDelete: Restrict, map: "fk_tipo_despesa_fixa_id")
  despesa_variavel_id      tipo_despesa_variavel? @relation(fields: [tipo_despesa_variavel_id], references: [id], onDelete: Restrict, map: "fk_tipo_despesa_variavel_id")
  responsavel_compra_id    String                 @db.Uuid
  usuarios                 usuarios               @relation(fields: [responsavel_compra_id], references: [id], onDelete: Restrict)
  // RELAÇÃO DINÂMICA: Aponta para o Plano de Contas global
  plano_contas_id          String                 @db.Uuid
  categoria_plano          plano_contas           @relation(fields: [plano_contas_id], references: [id], onDelete: Restrict)
  // lista reversa
  movimentacoes            Movimentacao[]
  fluxo_caixa              fluxo_caixa[]

  @@map("despesas")
}

/**
 * SEED
 * status_fiscal {
 * PENDENTE
 * PROCESSANDO
 * AUTORIZADA
 * REJEITADA
 * CANCELADA
 * CONTINGENCIA
 * }
 */

model status_fiscal {
  id               Int                @id @default(autoincrement())
  status_fiscal    String             @unique @db.VarChar(50)
  descricao        String?            @db.VarChar(255)
  // auditoria
  cadastradoEm     DateTime           @default(now()) @db.Timestamp(6)
  atualizadoEm     DateTime           @default(now()) @db.Timestamp(6)
  documento_fiscal documento_fiscal[] //indica que os status fiscais podem ser vinculados a vários documentos fiscais. Exe: uma nota fiscal pode ter o status "PENDENTE" ou "AUTORIZADA", e várias notas fiscais podem ter o mesmo status.
}

model modelo_documento_fiscal {
  id               Int                @id @default(autoincrement())
  numero_NF_e      Int                @unique
  nome             String             @unique @db.VarChar(50)
  // auditoria
  cadastradoEm     DateTime           @default(now()) @db.Timestamp(6)
  atualizadoEm     DateTime           @default(now()) @db.Timestamp(6)
  documento_fiscal documento_fiscal[] // relacao de um para muitos.
}

/**
 * SEED
 * modelo_documento_fiscal {
 * NFE  @map("55") // Nota Fiscal Eletrônica (Grandes movimentações / Venda de carros inteiros)
 * NFCE @map("65") // Cupom Fiscal Eletrônico (Venda rápida no balcão)
 * NFSE @map("00") // Nota Fiscal de Serviço Eletrônica (Prefeitura de Boa Vista)
 * }
 */

model documento_fiscal {
  id                            String  @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  // Origens do Faturamento (Opcionais pois uma nota pode vir de uma venda OU de uma O.S.)
  pedido_venda_id               String? @unique @db.Uuid
  ordem_servico_id              String? @unique @db.Uuid
  sucata_venda_id               String? @unique @db.Uuid // Venda de veículo inteiro de sucata
  modelo_nota_fiscal_eletronica Int // 55 = NF-e, 65 = NFC-e, 00 = NFSe
  serie                         Int     @default(1)
  numero                        Int     @unique // Sequencial controlado pelo emissor/SEFAZ
  chave_acesso                  String? @unique @db.VarChar(44) // Os 44 dígitos obrigatórios da NF-e/NFC-e
  status_fiscal_id              Int     @default(1) // PENDENTE
  protocolo_autorizacao_sefaz   String? @db.VarChar(255) // Número do protocolo de autorização da SEFAZ (Ex: 135210000000000)
  justificativa_rejeicao        String? @db.VarChar(255) // Justificativa da rejeição da SEFAZ (Ex: "Rejeição: Falha na validação do XML")

  // --- PARÂMETROS DE CONTINGÊNCIA OFFLINE (OBRIGATÓRIO SEFAZ/RR) ---
  tipo_emissao        Int       @default(1) // 1 = Normal, 9 = Contingência Offline NFC-e
  motivo_contingencia String?   @db.VarChar(255) // Justificativa da queda de conexão
  data_contingencia   DateTime? @db.Timestamp(6)

  // Retornos de Auditoria e Protocolo da SEFAZ
  codigo_status_sefaz Int? // Código cStat (Ex: 100 = Autorizado)
  motivo_status_sefaz String? @db.VarChar(255) // Descrição do status (Ex: "Autorizado o uso da NF-e")
  xml_protocolado     String? @db.Text // O XML assinado final exigido por lei por 5 anos
  url_pdf_danfe       String? @db.Text // Link direto para o PDF gerado pela sua API fiscal

  data_emissao     DateTime  @default(now()) @db.Timestamp(6)
  data_autorizacao DateTime? @db.Timestamp(6)
  // auditoria
  cadastradoEm     DateTime  @default(now()) @db.Timestamp(6)
  atualizadoEm     DateTime  @default(now()) @db.Timestamp(6)

  // Relacionamentos com as origens comerciais
  pedido_venda  pedidos_vendas?         @relation(fields: [pedido_venda_id], references: [id], onDelete: Restrict)
  ordem_servico ordem_servico?          @relation(fields: [ordem_servico_id], references: [id], onDelete: Restrict)
  sucata_venda  sucata_estoque?         @relation("FiscalSucataVenda", fields: [sucata_venda_id], references: [id], onDelete: Restrict)
  status_fiscal status_fiscal           @relation(fields: [status_fiscal_id], references: [id], onUpdate: Restrict, map: "fk_status_fiscal_id")
  modelo_fiscal modelo_documento_fiscal @relation(fields: [modelo_nota_fiscal_eletronica], references: [numero_NF_e], onUpdate: Restrict, map: "fk_modelo_documento_fiscal_id")

  @@map("documento_fiscal")
}

model fluxo_caixa {
  id                String             @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  descricao         String             @db.VarChar(255) // Ex: "Recebimento Pedido #X" ou "Pagamento Aluguel"
  tipo              TipoMovimentacao // ENTRADA ou SAIDA
  status            StatusMovimentacao // PENDENTE ou PAGO
  valor             Decimal            @db.Decimal(10, 2)
  metodo_pagamento  metodo_pagamento // Pix, Credito, Dinheiro, etc.
  data_movimentacao DateTime           @default(now()) @db.Timestamp(6)

  // Rastreadores de Origem para Conciliação Perfeita (Todas Opcionais)
  pedido_venda_id       String? @db.Uuid // Se veio de uma venda de balcão
  ordem_servico_id      String? @db.Uuid // Se veio do fechamento de uma O.S.
  despesa_id            String? @db.Uuid // Se foi pagamento de uma conta fixa/variável
  sucata_compra_id      String? @db.Uuid // Se gastou dinheiro comprando sucata para desmonte
  sucata_venda_id       String? @db.Uuid // Se entrou dinheiro vendendo um carro de sucata inteiro
  // CHAVES ESTRANGEIRAS
  objeto_duravel_id     String? @db.Uuid
  objeto_generico_id    String? @db.Uuid
  objeto_imobilizado_id String? @db.Uuid
  // 1. ADICIONE O CAMPO DA CHAVE ESTRANGEIRA (Obrigatório para classificar na DRE)
  plano_contas_id       String  @db.Uuid

  // Auditoria
  usuario_caixa_id             String                        @db.Uuid // Quem estava logado e operando o terminal na hora
  cadastradoEm                 DateTime                      @default(now()) @db.Timestamp(6)
  atualizadoEm                 DateTime                      @default(now()) @db.Timestamp(6)
  // Relacionamentos de Integridade
  pedido_venda                 pedidos_vendas?               @relation(fields: [pedido_venda_id], references: [id])
  ordem_servico                ordem_servico?                @relation(fields: [ordem_servico_id], references: [id])
  despesa                      despesas?                     @relation(fields: [despesa_id], references: [id])
  sucata_compra                sucata_compras?               @relation(fields: [sucata_compra_id], references: [id])
  sucata_venda                 sucata_estoque?               @relation(fields: [sucata_venda_id], references: [id])
  usuario_caixa                usuarios                      @relation(fields: [usuario_caixa_id], references: [id])
  estoque_objetos_duraveis     estoque_objetos_duraveis?     @relation(fields: [objeto_duravel_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estoque_objetos_genericos    estoque_objetos_genericos?    @relation(fields: [objeto_generico_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  estoque_objetos_imobilizados estoque_objetos_imobilizados? @relation(fields: [objeto_imobilizado_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // 2. ADICIONE O RELACIONAMENTO DE INTEGRIDADE
  plano_contas                 plano_contas                  @relation(fields: [plano_contas_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("fluxo_caixa")
}

