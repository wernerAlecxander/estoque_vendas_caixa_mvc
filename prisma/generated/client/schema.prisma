model CFOPS {
  id                    String               @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  codigo                String               @unique @db.VarChar(4) // Ex: "5102", "1102"
  descricao             String               @db.VarChar(255) // Descrição simplificada para o seu negócio
  tipo                  TipoMovimentacao // "ENTRADA" ou "SAIDA"
  // auditoria
  cadastradoEm          DateTime             @default(now()) @db.Timestamp(6)
  atualizadoEm          DateTime             @default(now()) @db.Timestamp(6)
  dadosFiscaisPecas     dados_fiscais_peca[]
  sucata_estoques       sucata_estoque[]
  sucata_estoques_venda sucata_estoque[]     @relation("CFOPVendaSucata")

  @@map("CFOPS")
}

model sucata_estoque {
  id                    String    @id @default(dbgenerated("gen_random_uuidv7()")) @db.Uuid
  modelo_id             Int
  ano_fabricacao        Int
  ano_modelo            Int
  chassi                String    @unique @db.VarChar(17)
  cor                   String    @unique @default("Preto") @db.VarChar(50)
  responsavel_compra_id String    @db.Uuid
  status_sucata         Int
  data_entrada          DateTime? @default(now()) @db.Timestamp(6)
  CFOP_id               String    @default("01900000-0000-7000-8000-000000005102") @db.Uuid
  // auditoria
  cadastradoEm          DateTime  @default(now()) @db.Timestamp(6)
  atualizadoEm          DateTime  @default(now()) @db.Timestamp(6)

  // --- NOVOS CAMPOS PARA PERMITIR A VENDA DO CARRO INTEIRO ---
  preco_venda_inteiro   Decimal?    @db.Decimal(10, 2) // Preço caso venda o carro inteiro sem desmontar
  data_venda_inteiro    DateTime?   @db.Timestamp(6)
  parceiro_comprador_id String?     @db.Uuid // Vinculo com o parceiro que comprou o carro
  cor_sucata            cor_veiculo @relation(fields: [cor], references: [cor], onUpdate: Restrict, map: "fk_cor_sucata_estoque")

  // Parâmetros Fiscais para Emissão da NF-e de saída do veículo inteiro (IMPLEMENTAR NO BACKEND)
  NMC_Mercosul_veiculo String         @default("87032310") @db.VarChar(8) // NMC_Mercosul padrão de automóveis
  CFOP_venda           String         @default("5102") @db.VarChar(4) // CFOP padrão de venda de mercadoria
  // relacionamentos reversos
  peca_estoque         peca_estoque[]
  // relacionamentos estruturais
  CFops                CFOPS          @relation(fields: [CFOP_id], references: [id], onUpdate: Restrict, onDelete: Cascade, map: "fk_CFOP_id")
  usuarios             usuarios       @relation(fields: [responsavel_compra_id], references: [id], onUpdate: Restrict, map: "fk_responsavel_compra_id")
  modelos              modelos        @relation(fields: [modelo_id], references: [id], onUpdate: Restrict, map: "fk_sucata_modelo_marca_id")
  status_sucata_id     status_sucata  @relation(fields: [status_sucata], references: [id], onUpdate: Restrict, map: "fk_status_sucata_id")

  // --- NOVOS RELACIONAMENTOS DO SISTEMA REESTRUTURADO ---
  parceiro_comprador parceiros?        @relation("CompradorSucataInteira", fields: [parceiro_comprador_id], references: [id], onDelete: Restrict)
  documento_fiscal   documento_fiscal? @relation("FiscalSucataVenda") // Vinculo com a nota fiscal de saída do carro
  lancamentos_caixa  fluxo_caixa[] // Vinculo com a entrada de dinheiro no Caixa
  CFOPS              CFOPS             @relation("CFOPVendaSucata", fields: [CFOP_venda], references: [codigo], onUpdate: Restrict, onDelete: Cascade)
}

model tipo_servico {
