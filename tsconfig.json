{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // Correção: Permite que o alias @/ busque tanto na raiz quanto dentro de src/
      "@/*": [
        "./*"
      ],
      "@models/*": [
        "./src/models/*"
      ],
      "@controllers/*": [
        "./src/controllers/*"
      ],
      "@schemas/*": [
        "./src/schemas/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      // Correção: Aponta os tipos do Prisma para o seu diretório customizado gerado
      "@prisma/client": [
        "./prisma/generated/client"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "application_stack_help",
    "backup_data_base_structure",
    "documentation_stack_app_info",
    "prisma.config.ts",
    // Correção: Ignora os arquivos de exemplo para não travar o compilador
    "rotas_e_pages_nextJS_exemplos"
  ]
}
